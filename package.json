{
  "name": "ponto",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:web": "tsc -b && vite build --mode web",
    "preview": "vite preview",
    "preview:web": "vite preview --outDir dist-web",
    "sync": "npm run build && cap sync android",
    "apk": "npm run sync && cd android && gradlew.bat assembleDebug",
    "icones:web": "node scripts/gerar-icones-web.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
